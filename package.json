{
  "name": "sports-store",
  "version": "0.1.0",
  "private": true,
  "description": "SMADI sports store \u2014 Next.js on Cloudflare Workers (OpenNext) with a D1 database.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "catalog": "node scripts/import-odoo.mjs && node scripts/odoo-catalog.mjs",
    "cutout": "python scripts/cutout-rembg.py",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 8787",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:local": "wrangler d1 migrations apply smadi --local",
    "db:remote": "wrangler d1 migrations apply smadi --remote",
    "photos": "node scripts/fetch-images.mjs && node scripts/odoo-catalog.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "wrangler": "4.166.0"
  }
}
