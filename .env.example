# Copy to .env.local and fill in. Never commit real values.
# Public site URL used for metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enables the /render route outside development (used by `npm run renders`). Keep unset in production.
ENABLE_RENDER_ROUTE=

# Future payment provider (NOT used by the demo checkout). Server-side only.
PAYMENT_PROVIDER_SECRET_KEY=replace-me
